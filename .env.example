# =====================================================
# WNBA Stats Analyzer - configuración
# =====================================================

# Base de datos SQLite
DB_PATH=wnba.db

# Odds: DESACTIVADAS por defecto.
# La app debe funcionar completamente sin odds.
ENABLE_ODDS=false

# Proveedor de datos deportivos:
# demo  -> datos ficticios, sin red
# espn  -> proveedor no oficial ESPN, puede fallar/cambiar
# file  -> lee data/scoreboard.json y data/history.json
SPORTS_PROVIDER=demo

# Proveedor de odds solo se usa si ENABLE_ODDS=true
# demo       -> odds ficticias para pruebas locales
# theoddsapi -> The Odds API, requiere key y verificación de plan
ODDS_PROVIDER=demo
ODDS_API_KEY=
ODDS_REGION=us
ODDS_MARKET=totals
ODDS_SPORT_KEY=basketball_wnba

# ESPN no oficial, si SPORTS_PROVIDER=espn
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/wnba

# Live polling
POLL_SECONDS=20
CACHE_SECONDS=15
HTTP_TIMEOUT=10
MAX_RETRIES=2

# Histórico
# Últimos N partidos por equipo para promedios históricos.
HIST_WINDOW=10

# Mínimo de partidos históricos por equipo antes de confiar
# razonablemente en promedios históricos.
WNBA_MIN_HIST_GAMES=8

# Backtest puro: momento del partido para congelar la predicción.
# 3 = final del tercer cuarto.
SNAPSHOT_QUARTER=3

# Modelo combinado / señales
H2H_WEIGHT=0.10
SIGNAL_THRESHOLD=2.0
INTERVAL_Z=1.28

# Carpeta para FileProvider
DATA_DIR=data
